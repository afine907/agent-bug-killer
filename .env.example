# Agent Bug Killer 环境变量配置
# 复制此文件为 .env 并填入你的配置:
#   cp .env.example .env

# ============================================================
# LLM 配置 (必需)
# ============================================================

# Claude API 密钥 (必需)
# 获取方式: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# 默认模型 (可选, 默认: anthropic:claude-sonnet-4-6)
# 可选值: anthropic:claude-sonnet-4-6, anthropic:claude-haiku-4-5-20251001
# DEFAULT_MODEL=anthropic:claude-sonnet-4-6

# ============================================================
# SSH 配置 (场景2: Bug Diagnoser, 可选)
# ============================================================

# SSH 私钥路径
# SSH_KEY_PATH=~/.ssh/id_rsa

# 默认 SSH 用户名
# SSH_DEFAULT_USER=root

# SSH 连接超时 (秒)
# SSH_TIMEOUT=30

# ============================================================
# CDP 配置 (场景2: Bug Diagnoser, 可选)
# ============================================================

# Chrome DevTools Protocol WebSocket URL
# 启动 Chrome: chrome --remote-debugging-port=9222
# CDP_BROWSER_WS=ws://localhost:9222/devtools/browser/...

# CDP 连接超时 (秒)
# CDP_TIMEOUT=10

# 截图保存目录
# SCREENSHOT_DIR=./screenshots

# ============================================================
# 日志配置
# ============================================================

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 日志解析最大行数
# LOG_PARSE_MAX_LINES=10000
